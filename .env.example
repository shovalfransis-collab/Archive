# Copy this file to .env.local and fill in real values for local development —
# or just run `vercel env pull .env.local` once the project is deployed and
# it will create this file for you automatically, filled in already.

# --- Added automatically by Vercel when you create + link a Postgres store
# (powered by Neon) to your project ---
DATABASE_URL=

# --- Added automatically by Vercel when you create + link a Blob store ---
BLOB_READ_WRITE_TOKEN=

# --- You set these two yourself (see README.md) ---
# The PIN you'll type to unlock the app.
ARCHIVE_PIN=1234
# A random string used to sign your login cookie. Any long random text works.
AUTH_SECRET=change-me-to-something-random
